# ─── Serveur ───────────────────────────────────────────────────────────────
PORT=3737
DOMAIN=devval.com

# Reverse proxy — IP/CIDR tel qu'il est vu depuis le conteneur.
# Avec un port Docker publié sur loopback, Nginx hôte apparaît généralement
# comme la gateway du bridge (par ex. 172.17.0.1), et non comme 127.0.0.1.
# Vérifier cette adresse sur chaque hôte ; ne jamais utiliser '*' ou 'true'.
FORTIFLOW_TRUST_PROXY=

# ─── Upload / Parsing ───────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=2048
MAX_DECOMPRESSED_SIZE_MB=4096
MAX_ARCHIVE_ENTRIES=100
MAX_XLSX_SIZE_MB=100
MAX_WORKSPACE_UNCOMPRESSED_MB=1024

# ─── Sessions ───────────────────────────────────────────────────────────────
MAX_SESSION_DEDUPE_KEYS=2000000

# ─── Analysis Pool ──────────────────────────────────────────────────────────
MAX_ANALYSIS_WORKERS=1
MAX_ANALYSIS_QUEUE=3
ANALYSIS_WORKER_MEMORY_MB=0

# ─── TLS — certificats (optionnel) ──────────────────────────────────────────
# Monter le répertoire des certificats dans le conteneur via :
#   volumes:
#     - /etc/ssl/fortiflow:/certs:ro
# Puis définir les chemins internes :
# SSL_KEY=/certs/privkey.pem
# SSL_CERT=/certs/fullchain.pem
# Ou passer un répertoire personnalisé :
# CUSTOM_SSL_DIR=/chemin/vers/certificats
